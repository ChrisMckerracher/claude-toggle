{
  "name": "@codex-proxy/codex",
  "version": "1.0.0",
  "description": "Codex proxy server - Anthropic API to ChatGPT/Codex API translation",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./auth": {
      "types": "./dist/auth/oauth.d.ts",
      "import": "./dist/auth/oauth.js"
    },
    "./codex": {
      "types": "./dist/bridge/codex.d.ts",
      "import": "./dist/bridge/codex.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "node dist/index.js",
    "login": "node dist/cli/login.js",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@codex-proxy/provider-core": "workspace:*",
    "eventsource-parser": "^3.0.6",
    "fastify": "^5.7.4",
    "he": "^1.2.0",
    "jose": "^6.1.3",
    "mdast-util-from-markdown": "^2.0.2",
    "micromark": "^4.0.2",
    "open": "^11.0.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/he": "^1.2.3",
    "@types/node": "^25.2.1",
    "typescript": "^5.9.3"
  }
}
