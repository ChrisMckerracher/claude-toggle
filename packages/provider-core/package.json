{
  "name": "@codex-proxy/provider-core",
  "version": "1.0.0",
  "description": "Shared provider storage and mapping domain for codex CLI/proxy",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
